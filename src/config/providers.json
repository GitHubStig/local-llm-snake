{
  "providers": [
    {
      "id": "ollama",
      "label": "Ollama",
      "baseUrl": "http://localhost:11434",
      "api": "ollama",
      "prompt": "default"
    },
    {
      "id": "apple",
      "label": "Apple Foundation Models",
      "baseUrl": "http://127.0.0.1:1976",
      "api": "openai",
      "prompt": "apple"
    }
  ],
  "modelAdvice": [
    { "capability": "image", "tier": "unusable", "reason": "Image generation, not chat" },
    { "match": "ocr", "tier": "avoid", "reason": "OCR-specialised" },
    { "match": ":text$", "tier": "avoid", "reason": "Base model, no chat template" },
    {
      "match": "^llama3:",
      "tier": "avoid",
      "reason": "Measured 2/10 on unambiguous boards; truncates silently above 8k"
    },
    {
      "match": "^qwen3-vl:",
      "tier": "avoid",
      "reason": "Returns empty content; unbounded generation with a free-text field"
    },
    { "minParams": 20, "tier": "slow", "reason": "Likely to miss the tick deadline" }
  ]
}
