{
  "providers": [
    {
      "id": "ollama",
      "label": "Ollama",
      "baseUrl": "http://localhost:11434",
      "api": "ollama",
      "defaultModel": "tev1:latest"
    },
    {
      "id": "apple",
      "label": "Apple Foundation Models",
      "baseUrl": "/fm",
      "api": "openai"
    }
  ],
  "modelAdvice": [
    {
      "capability": "image",
      "tier": "unusable",
      "reason": "Image generation, not chat"
    },
    {
      "match": "ocr",
      "tier": "avoid",
      "reason": "OCR-specialised"
    },
    {
      "match": "uncensored",
      "tier": "avoid",
      "reason": "Excluded from this project"
    },
    {
      "match": ":text$",
      "tier": "avoid",
      "reason": "Base model, no chat template"
    },
    {
      "match": "^qwen3-vl:",
      "tier": "avoid",
      "reason": "Returns empty content; unbounded generation with a free-text field"
    },
    {
      "minParams": 20,
      "tier": "slow",
      "reason": "Likely to miss the tick deadline"
    }
  ]
}
