    "@vitejs/plugin-vue": "6.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.0.18",
    "oxlint": "1.42.0",
    "prettier": "3.6.2",
    "vue-tsc": "3.2.2"
  },
  "description": "A playground for comparing local LLMs by having them play snake"
