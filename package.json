    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "vue": "3.5.43",
    "@vueuse/core": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
